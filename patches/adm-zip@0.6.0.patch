+function resolveThroughExistingAncestors(/*string*/ path) {
+    let current = path;
+    for (;;) {
+        try {
+            return pth.join(fsystem.realpathSync(current), pth.relative(current, path));
+        } catch (e) {
+            const parent = pth.dirname(current);
+            if (parent === current) throw e;
+            current = parent;
+        }
+    }
+}
+
+Utils.assertContained = function (/*string*/ prefix, /*string*/ target) {
+    let stat;
+    try {
+        stat = fsystem.lstatSync(target);
+    } catch (e) {
+        stat = undefined;
+    }
+    if (stat && stat.isSymbolicLink()) {
+        throw new Error(`Out of bound symlink at extraction target "${target}"`);
+    }
+    const root = resolveThroughExistingAncestors(prefix);
+    const resolved = resolveThroughExistingAncestors(target);
+    if (resolved !== root && !resolved.startsWith(root + pth.sep)) {
+        throw new Error(`Out of bound symlink found while extracting to "${target}"`);
+    }
+    return target;
+};
