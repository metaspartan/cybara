# Cybara environment variables.
#
# Copy to `.env` and fill in the keys you use. All variables are optional —
# cybara runs fully local-only with zero keys. Providers, channels, and tools
# activate as you add credentials. See docs/providers.md, docs/channels.md,
# docs/tools.md, and docs/desktop.md for details.

# ---------------------------------------------------------------------------
# LLM Providers (set the ones you use)
# ---------------------------------------------------------------------------

# OpenAI (also enables Codex / gpt-image)
OPENAI_API_KEY=
# Multi-key rotation: OPENAI_API_KEY_2, OPENAI_API_KEY_3, ... (or comma-separated)

# Anthropic (Claude). Prompt caching + multi-key rotation apply automatically.
ANTHROPIC_API_KEY=

# Google AI / Gemini
GEMINI_API_KEY=
# GOOGLE_API_KEY is read as an alias.

# Z.AI (GLM) — also accepts GLM_API_KEY / Z_AI_API_KEY
ZAI_API_KEY=
GLM_BASE_URL=

# DeepSeek, MiniMax, Moonshot (Kimi), xAI (Grok), NVIDIA, Alibaba DashScope
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
KIMI_API_KEY=
KIMI_BASE_URL=
XAI_API_KEY=
XAI_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
DASHSCOPE_API_KEY=

# Aggregators / gateways
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=
GROQ_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=
NOVITA_API_KEY=
STEPFUN_API_KEY=
GMI_API_KEY=

# Coding-plan providers (often free/cheap tiers)
ALIBABA_CODING_PLAN_API_KEY=

# GitHub Copilot
GITHUB_TOKEN=
# COPILOT_API_BASE_URL=

# Local runtimes (no key by default)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LM_BASE_URL=http://127.0.0.1:1234/v1

# ---------------------------------------------------------------------------
# Media Generation
# ---------------------------------------------------------------------------

# OpenAI image generation (uses OPENAI_API_KEY above).
# fal.ai image / video / music generation (also accepts FAL_API_KEY)
FAL_KEY=

# ElevenLabs TTS (also accepts XI_API_KEY)
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Web research providers. Search falls back to DuckDuckGo; extraction falls back to direct fetch.
# ---------------------------------------------------------------------------

FIRECRAWL_API_KEY=
# Optional self-hosted Firecrawl base URL. A self-hosted endpoint can run without a cloud key.
FIRECRAWL_API_URL=
PARALLEL_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=

# ---------------------------------------------------------------------------
# Channels (set only the ones you connect)
# ---------------------------------------------------------------------------

# Telegram
TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# WhatsApp (whatsapp-web.js) — no env; pair via QR in the UI.

# Signal (signal-cli) — configure signal-cli-cli separately.

# iMessage (BlueBubbles) — configure the BlueBubbles server separately.

# ---------------------------------------------------------------------------
# Desktop / Tauri release signing (maintainers only — see docs/desktop.md)
# ---------------------------------------------------------------------------

# Tauri updater keypair (generate with: bunx @tauri-apps/cli signer generate -w key)
TAURI_SIGNING_PUBLIC_KEY=
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Apple codesigning + notarization (native macOS builds)
APPLE_DEVELOPER_ID_CERTIFICATE_P12=
APPLE_DEVELOPER_ID_CERTIFICATE_PASSWORD=
APPLE_DEVELOPER_ID_SIGNING_IDENTITY=
APPLE_KEYCHAIN_PASSWORD=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ---------------------------------------------------------------------------
# Optional runtime behavior
# ---------------------------------------------------------------------------

# Disable the non-blocking "update available" startup probe (TUI + web banner)
# CYBARA_DISABLE_UPDATE_CHECK=1

# Override the cua-driver binary path for computer_use (default: cua-driver on $PATH)
# CYBARA_CUA_DRIVER_CMD=/usr/local/bin/cua-driver

# Server port (default 4269)
# PORT=4269
