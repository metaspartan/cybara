{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "dependencies", "devDependencies", "unlisted", "binaries", "unresolved"],
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "src/main.ts",
        "src/cli-*.{ts,tsx}",
        "scripts/*.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": [
        "@huggingface/transformers",
        "@typescript/native",
        "typescript-language-server"
      ],
      "ignoreBinaries": [
        "preview",
        "go",
        "swift",
        "codesign",
        "sips",
        "iconutil",
        "ditto",
        "xcrun",
        "netstat",
        "lsof",
        "open",
        "pgrep"
      ]
    },
    "ui": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.config.{js,ts}"],
      "ignoreDependencies": ["@typescript/native"]
    },
    "apps/mobile": {
      "entry": ["App.tsx", "src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@typescript/native"]
    }
  }
}
