{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "dependencies", "devDependencies", "unlisted", "binaries", "unresolved"],
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "src/main.ts",
        "src/cli-*.ts",
        "scripts/*.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["@huggingface/transformers", "typescript-language-server"],
      "ignoreBinaries": [
        "preview",
        "go",
        "swift",
        "codesign",
        "sips",
        "iconutil",
        "ditto",
        "xcrun",
        "netstat",
        "lsof",
        "open",
        "xdg-open",
        "pgrep"
      ]
    },
    "ui": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.config.{js,ts}"]
    },
    "apps/mobile": {
      "entry": ["App.tsx", "src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
