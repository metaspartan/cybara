{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cybara",
  "version": "1.0.1273",
  "identifier": "com.cybara.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ui && bun run dev",
    "beforeBuildCommand": "cd ui && bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Cybara",
        "width": 1320,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' http://127.0.0.1:4269 http://localhost:5173 ws://127.0.0.1:4269 ws://localhost:5173 https:; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "bin/node_modules": "node_modules",
      "bin/runtime": "runtime",
      "bin/ui/dist": "ui/dist",
      "bin/secp256k1.wasm": "secp256k1.wasm"
    },
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "externalBin": [
      "bin/cybara"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "markdown",
          "json",
          "jsonc",
          "js",
          "jsx",
          "mjs",
          "cjs",
          "ts",
          "tsx",
          "html",
          "htm",
          "css",
          "scss",
          "less",
          "py",
          "rs",
          "go",
          "java",
          "kt",
          "swift",
          "c",
          "h",
          "cc",
          "cpp",
          "hpp",
          "cs",
          "rb",
          "php",
          "sh",
          "bash",
          "zsh",
          "yaml",
          "yml",
          "toml",
          "ini",
          "cfg",
          "env",
          "xml",
          "sql",
          "lua",
          "vue",
          "svelte",
          "astro",
          "dart",
          "ex",
          "exs"
        ],
        "name": "Cybara Source File",
        "description": "Open with Cybara",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI Agent Platform",
    "longDescription": "Cybara - A powerful AI agent platform with beautiful web UI",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowPosition": {
          "x": 200,
          "y": 200
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "dev-placeholder-updater-key"
    },
    "shell": {
      "open": true
    }
  }
}
