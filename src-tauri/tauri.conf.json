{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Cybara",
    "version": "0.1.0",
    "identifier": "com.cybara.desktop",
    "build": {
        "frontendDist": "../ui/dist",
        "devUrl": "http://localhost:4269"
    },
    "app": {
        "windows": [
            {
                "title": "Cybara",
                "width": 1280,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "dmg",
            "app",
            "msi",
            "nsis",
            "deb",
            "appimage"
        ],
        "externalBin": [
            "bin/cybara"
        ],
        "category": "DeveloperTool",
        "shortDescription": "AI Agent Platform",
        "longDescription": "Cybara - A powerful AI agent platform with beautiful web UI",
        "macOS": {
            "minimumSystemVersion": "10.15",
            "dmg": {
                "windowPosition": {
                    "x": 200,
                    "y": 200
                },
                "windowSize": {
                    "width": 660,
                    "height": 400
                },
                "appPosition": {
                    "x": 180,
                    "y": 170
                },
                "applicationFolderPosition": {
                    "x": 480,
                    "y": 170
                }
            }
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        },
        "linux": {
            "appimage": {
                "bundleMediaFramework": true
            }
        }
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}