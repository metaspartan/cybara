{
    "identifier": "default",
    "description": "Default capabilities for the Cybara desktop app",
    "windows": [
        "main"
    ],
    "remote": {
        "urls": [
            "http://127.0.0.1:4269",
            "http://localhost:5173"
        ]
    },
    "permissions": [
        "core:default",
        "shell:default",
        "notification:default",
        "notification:allow-is-permission-granted",
        "notification:allow-request-permission",
        "notification:allow-notify",
        "notification:allow-show",
        "dialog:default",
        "dialog:allow-open",
        "process:default",
        "updater:default"
    ]
}
