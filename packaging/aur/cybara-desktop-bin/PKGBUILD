# Maintainer: Carsen Klock <carsen@wombo.ai>
pkgname=cybara-desktop-bin
pkgver=0.0.0
pkgrel=1
pkgdesc="Cybara — self-hosted, open-source AI agent platform (desktop app, prebuilt)"
arch=('x86_64' 'aarch64')
url="https://github.com/metaspartan/cybara"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
provides=('cybara-desktop')
conflicts=('cybara-desktop')
options=('!strip')
source_x86_64=("cybara-desktop-${pkgver}-x86_64.deb::https://github.com/metaspartan/cybara/releases/download/v${pkgver}/Cybara_${pkgver}_amd64.deb")
source_aarch64=("cybara-desktop-${pkgver}-aarch64.deb::https://github.com/metaspartan/cybara/releases/download/v${pkgver}/Cybara_${pkgver}_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local deb="cybara-desktop-${pkgver}-${CARCH}.deb"
  bsdtar -xf "${srcdir}/${deb}"
  bsdtar -xf "${srcdir}/data.tar.gz" -C "${pkgdir}" 2>/dev/null \
    || bsdtar -xf "${srcdir}/data.tar.xz" -C "${pkgdir}" 2>/dev/null \
    || bsdtar -xf "${srcdir}/data.tar.zst" -C "${pkgdir}"
}
