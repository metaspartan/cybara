{
  "name": "cybara-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3399 --strictPort",
    "build": "bun ./node_modules/@typescript/native/bin/tsc --noEmit && vite build && bun run scripts/generate-pages.ts && bun run scripts/precompress.ts",
    "preview": "vite preview --port 3399 --strictPort",
    "typecheck": "bun ./node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  },
  "overrides": {
    "nanoid": "3.3.20",
    "postcss": "8.5.31",
    "source-map-js": "1.2.2"
  }
}
