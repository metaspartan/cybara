<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The bundled Bun sidecar runs JavaScriptCore (JIT). Hardened runtime needs
       these to allow the JS engine to execute. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The app loads the sidecar + native node modules (bun, onnxruntime, etc.). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The sidecar binds a localhost HTTP/WS gateway and makes outbound LLM calls. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- Capture features (nodes camera_snap / computer_use) — only used when the
       user explicitly invokes them; macOS still prompts via the usage strings. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
