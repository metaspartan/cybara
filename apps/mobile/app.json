{
  "expo": {
    "name": "Cybara",
    "slug": "cybara-mobile",
    "version": "1.0.1973",
    "orientation": "portrait",
    "scheme": "cybara",
    "icon": "./assets/cybara.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/cybara.png",
      "resizeMode": "contain",
      "backgroundColor": "#03070b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ck.cybara",
      "entitlements": {
        "aps-environment": "development"
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your Cybara gateway on your local network.",
        "NSUserNotificationsUsageDescription": "Receive notifications when Cybara finishes a chat or task.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "buildNumber": "1001973"
    },
    "android": {
      "package": "com.ck.cybara",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/cybara.png",
        "backgroundColor": "#071016"
      },
      "versionCode": 1001973
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a Cybara gateway QR code to connect this device."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to your Cybara chat messages."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#f97316",
          "defaultChannel": "cybara"
        }
      ],
      "expo-secure-store",
      "./plugins/with-android-lan-cleartext"
    ],
    "extra": {
      "gatewayContract": "cybara-mobile-connect-v1"
    }
  }
}
