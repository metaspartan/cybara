{
  "expo": {
    "name": "Cybara",
    "slug": "cybara-mobile",
    "version": "1.0.869",
    "orientation": "portrait",
    "scheme": "cybara",
    "icon": "./assets/cybara.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/cybara.png",
      "resizeMode": "contain",
      "backgroundColor": "#03070b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ck.cybara"
    },
    "android": {
      "package": "com.ck.cybara",
      "adaptiveIcon": {
        "foregroundImage": "./assets/cybara.png",
        "backgroundColor": "#071016"
      },
      "versionCode": 1000869
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a Cybara gateway QR code to connect this device."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "gatewayContract": "cybara-mobile-connect-v1"
    }
  }
}
