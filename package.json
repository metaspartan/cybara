{
  "name": "cybara",
  "version": "1.0.0",
  "description": "AI agent platform with beautiful web UI",
  "type": "module",
  "bin": {
    "cybara": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run build && cd ui && bun run build && cd .. && bun run --watch src/index.ts",
    "postinstall": "bunx playwright install",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:cli": "bun build src/cli.tsx --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "cli": "bun run src/cli.tsx",
    "ui:dev": "cd ui && bun dev",
    "ui:build": "cd ui && bun run build",
    "ui:preview": "cd ui && bun preview",
    "build:all": "bun run ui:build && bun run build && bun run build:cli",
    "start:prod": "bun run build:all && bun run start",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run format:check"
  },
  "dependencies": {
    "chromium-bidi": "^13.1.0",
    "electron": "^40.1.0",
    "ink": "^6.6.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "playwright": "^1.58.0",
    "puppeteer-core": "^24.36.1",
    "react": "^19.1.0",
    "react-devtools-core": "^7.0.1",
    "tinyglobby": "^0.2.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/react": "^19.1.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "Carsen Klock",
  "repository": {
    "type": "git",
    "url": "https://github.com/metaspartan/cybara.git"
  }
}