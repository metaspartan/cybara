    "sharp": "0.35.5",
    "shell-quote": "1.12.0",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2",
    "socket.io-parser": "4.2.7",
    "stream-json": "3.8.0",
    "tar": "7.5.22",
    "@toon-format/toon": "4.4.0",
    "undici": "8.12.3",
    "unzipper": "0.12.5",
    "uuid": "11.1.1",
    "valibot": "1.5.0",
    "ws": "8.22.1",
    "zod": "4.6.7",
    "glob": "14.0.3"
  },
  "license": "MIT",
  "author": "Carsen Klock @metaspartan",
  "homepage": "https://github.com/metaspartan/cybara",
  "keywords": [
    "ai-agent",
    "llm",
    "multi-agent",
    "mcp",
    "agent-platform",
    "cli",
    "bun",
    "tauri",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/metaspartan/cybara.git"
  },
  "knip": {
    "ignore": [
      "tests/fixtures/session-crash-recovery-worker.ts"
    ]
  },
  "patchedDependencies": {
    "extract-zip@2.0.1": "patches/extract-zip@2.0.1.patch",
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
}
