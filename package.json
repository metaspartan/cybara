{
  "name": "cybara",
  "version": "1.0.2529",
  "description": "Open-source multi-agent AI platform with CLI, web, desktop, and mobile apps, broad provider and channel support, MCP host/client, media generation, and multi-agent orchestration.",
  "type": "module",
  "bin": {
    "cybara": "./dist/main.js"
  },
  "scripts": {
    "dev": "bun run build && cd ui && bun run build && cd .. && bun run --watch src/index.ts",
    "postinstall": "bun run scripts/postinstall.ts",
    "version:print": "bun run scripts/version.ts print",
    "version:sync": "bun run scripts/version.ts sync",
    "build": "bun build src/index.ts --outdir dist --target bun --external electron --external @aws-sdk/client-s3 --external tiny-secp256k1 --external kokoro-js --external @huggingface/transformers --external ssh2",
    "build:cli": "bun build src/cli/index.tsx --outdir dist --entry-naming cli.js --target bun --external electron --external @aws-sdk/client-s3 --external tiny-secp256k1 --external ssh2",
    "build:main": "bun build src/main.ts --outdir dist --target bun --external electron --external @aws-sdk/client-s3 --external tiny-secp256k1 --external ssh2",
    "start": "bun run dist/index.js",
    "cli": "bun run src/cli/index.tsx",
    "ui:dev": "cd ui && bun dev",
    "ui:build": "cd ui && bun run build",
    "ui:preview": "cd ui && bun preview",
    "mobile:dev": "cd apps/mobile && bun run dev",
    "mobile:ios": "cd apps/mobile && bun run ios",
    "mobile:android": "cd apps/mobile && bun run android",
    "mobile:expo-check": "cd apps/mobile && bunx expo install --check",
    "mobile:typecheck": "cd apps/mobile && bun run typecheck",
    "doctor": "bun run scripts/react-doctor.ts",
    "ui:lint": "cd ui && bun run lint",
    "ui:typecheck": "cd ui && bun run typecheck",
    "build:all": "bun run ui:build && bun run build && bun run build:cli && bun run build:main",
    "start:prod": "bun run build:all && bun run start",
    "package": "bun run scripts/package.ts",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "bun eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"apps/mobile/App.tsx\" \"apps/mobile/app.config.ts\" \"apps/mobile/src/**/*.{ts,tsx}\"",
    "typecheck": "bun ./node_modules/@typescript/native/bin/tsc --noEmit",
    "check:loc": "bun run scripts/check-source-max-loc.ts --max 2000",
    "check:browser-extension": "bun run scripts/browser-extension-policy.ts",
    "package:browser-extension": "bun run scripts/package-browser-extension.ts",
    "deadcode": "bash scripts/run-knip.sh --no-progress",
    "deadcode:report": "bash scripts/run-knip.sh --no-progress --reporter compact --no-exit-code",
    "profile:macos": "bun run scripts/profile-cybara-macos.ts",
    "benchmark:gateway": "bun run build && bun run scripts/benchmark-gateway.ts",
    "audit:root": "bun scripts/security-audit.ts root",
    "audit:ui": "bun scripts/security-audit.ts ui",
    "audit:mobile": "bun scripts/security-audit.ts mobile",
    "audit:site": "bun scripts/security-audit.ts site",
    "audit:ci": "bun scripts/security-audit.ts",
    "security:osv": "go run github.com/google/osv-scanner/v2/cmd/osv-scanner@v2.3.8 scan source --config=osv-scanner.toml --lockfile=bun.lock --lockfile=ui/bun.lock --lockfile=apps/mobile/bun.lock --lockfile=src-tauri/Cargo.lock .",
    "tauri:audit": "cd src-tauri && cargo audit",
    "check:ci": "bun run typecheck && bun run ui:typecheck && bun run lint && bun run ui:lint && bun run format:check && bun run check:loc && bun run check:browser-extension && bun run mobile:expo-check && bun run mobile:typecheck && bun run doctor && bun run test:smoke && bun run deadcode",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "test:isolated": "bun run scripts/run-tests-isolated.ts",
    "test:core": "bun run test:isolated tests/core",
    "test:mobile": "bun run test:isolated tests/mobile",
    "test:smoke": "bun run scripts/run-smoke-tests.ts",
    "test:smoke:full": "bun run test:core && bun run test:isolated tests/runtime && bun run test:isolated tests/api/security.test.ts tests/api/browser-routes-mocked.test.ts tests/api/channel-security-routes-mocked.test.ts && bun run test:isolated tests/e2e",
    "test": "bun run test:isolated tests/core tests/api tests/channels tests/cli tests/runtime tests/mobile tests/ui",
    "sexy": "bun run typecheck && bun run lint && bun run format:check",
    "sexy:write": "bun run typecheck && bun run lint && bun run format",
    "tauri": "tauri",
    "tauri:dev": "bun run tauri:dev:prep && bun run tauri:sidecar && bunx tauri dev",
    "tauri:dev:prep": "bun run scripts/prepare-tauri-dev.ts && bun run package",
    "tauri:prepare-release": "bun run scripts/prepare-tauri-release.ts",
    "tauri:build": "bun run tauri:sidecar && bunx tauri build",
    "tauri:build:release": "bun run tauri:sidecar && bun run tauri:prepare-release && bunx tauri build --config src-tauri/tauri.release.conf.json",
    "tauri:sidecar": "bun run scripts/build-sidecar.ts",
    "native:macos:build": "swift build --package-path apps/macos/Cybara",
    "native:macos:run": "bun run ui:build && bun run tauri:sidecar && swift run --package-path apps/macos/Cybara",
    "native:macos:package": "bun run scripts/package-native-macos.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@aws-sdk/client-bedrock-runtime": "3.1162.0",
    "@huggingface/transformers": "4.3.2",
    "@lobehub/icons": "6.15.0",
    "@puppeteer/browsers": "3.2.6",
    "@scure/bip39": "2.4.0",
    "@slack/bolt": "5.1.0",
    "@smithy/types": "4.20.0",
    "@solana/signers": "8.6.0",
    "@solana/web3.js": "1.99.0",
    "@toon-format/toon": "4.4.0",
    "@vtsls/language-server": "0.3.0",
    "@x402/evm": "2.30.0",
    "@x402/fetch": "2.30.0",
    "@x402/svm": "2.30.0",
    "bash-language-server": "5.8.1",
    "bip32": "5.0.1",
    "bitcoinjs-lib": "7.0.5",
    "bonjour-service": "1.4.4",
    "chromium-bidi": "159.0.8144-0",
    "discord.js": "14.28.1",
    "e2b": "2.63.0",
    "ecpair": "3.0.2",
    "ed25519-hd-key": "2.0.0",
    "ethers": "6.17.0",
    "heic-convert": "2.1.0",
    "heic-decode": "2.1.0",
    "ink": "8.0.0",
    "ink-gradient": "4.0.1",
    "ink-spinner": "5.0.0",
    "kokoro-js": "1.2.1",
    "libheif-js": "1.23.5",
    "playwright": "1.64.1",
    "puppeteer-core": "25.16.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "react": "19.3.1",
    "react-devtools-core": "8.0.0",
    "sharp": "0.35.5",
    "socket.io-client": "4.8.4",
    "ssh2": "1.17.0",
    "tiff": "7.1.3",
    "tiny-secp256k1": "2.2.5",
    "undici": "8.12.3",
    "unpdf": "2.1.0",
    "unzipper": "0.12.5",
    "vscode-langservers-extracted": "4.10.0",
    "whatsapp-web.js": "1.34.7",
    "yaml-language-server": "2.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@eslint/js": "10.0.1",
    "@smithy/node-http-handler": "4.14.2",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "knip": "6.44.1",
    "pngjs": "7.0.0",
    "react-doctor": "0.9.22",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.3"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "axios": "1.21.0",
    "basic-ftp": "6.2.6",
    "bn.js": "5.2.5",
    "body-parser": "2.4.0",
    "brace-expansion": "1.1.21",
    "browserslist": "4.29.5",
    "@discordjs/rest": "2.6.3",
    "dompurify": "3.4.17",
    "fast-uri": "3.1.9",
    "flatted": "3.4.4",
    "follow-redirects": "1.16.2",
    "form-data": "4.0.6",
    "@humanfs/node": "0.17.0",
    "ip-address": "10.7.6",
    "js-yaml": "5.5.0",
    "katex": "0.19.1",
    "lodash": "4.18.1",
    "mermaid": "11.16.1",
    "minimatch": "5.1.8",
    "onnxruntime-common": "1.31.1",
    "onnxruntime-node": "1.31.1",
    "path-to-regexp": "8.4.2",
    "protobufjs": "8.8.1",
    "proxy-addr": "2.0.8",
